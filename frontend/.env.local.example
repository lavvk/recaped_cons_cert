# Address of the deployed RecapedEvents contract.
# Optional: if missing, the frontend falls back to lib/deployed-address.json
# (which the deploy script writes automatically).
NEXT_PUBLIC_CONTRACT_ADDRESS=

# Chain id the contract is deployed on. 31337 = local Hardhat, 11155111 = Sepolia.
# If unset, falls back to lib/deployed-address.json (written by the deploy script).
NEXT_PUBLIC_CHAIN_ID=

# Optional: a real WalletConnect Cloud project id (https://cloud.walletconnect.com/).
# When set, the wallet modal shows MetaMask, Coinbase Wallet, WalletConnect, etc.
# When NOT set (local demo), the wallet modal shows only the injected wallet
# (the MetaMask browser extension via window.ethereum). No fake project id is used.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID= 93163fb4df01322e09ebf904e3a8babd
